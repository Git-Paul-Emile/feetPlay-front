# ═══════════════════════════════════════════════════════════════════
#  feetiPlay — Frontend — Variables d'environnement (Vite)
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════

# ── Backend feetiPlay ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8001

# ── Cross-app — feeti2 ────────────────────────────────────────────────
VITE_FEETI2_URL=http://localhost:3000

# ── Mux (lecteur vidéo côté frontend) ───────────────────────────────
# Obtenir sur dashboard.mux.com > Settings > Environments
# Chaque environnement (dev/prod) a son propre env key
VITE_MUX_ENV_KEY=CHANGE_ME_MUX_ENV_KEY
