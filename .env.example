# ═══════════════════════════════════════════════════════════════════
#  feetiPlay — Frontend — Variables d'environnement (Vite)
#  Dev  : copier en .env et remplir les valeurs
#  Prod : configurer dans les Environment Variables de Vercel
# ═══════════════════════════════════════════════════════════════════

# ── Backend API ───────────────────────────────────────────────────────
# Dev local (Express backend) :
VITE_API_URL=http://localhost:8001
# Production (Render backend) :
# VITE_API_URL=https://feetiplay-back.onrender.com

# Fournisseur backend par défaut : "express" | "firebase" (voir app/services/backend/mode.ts)
VITE_BACKEND_PROVIDER=express

# ── Cross-app — feeti2 ────────────────────────────────────────────────
# Dev :
VITE_FEETI2_URL=http://localhost:3000
# Prod :
# VITE_FEETI2_URL=https://feeti2.vercel.app

# ── Firebase (projet feetiPlay) ──────────────────────────────────────
# Obtenir sur console.firebase.google.com > feetiplay-dev > Paramètres du projet
VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=feetiplay-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=feetiplay-dev
VITE_FIREBASE_STORAGE_BUCKET=feetiplay-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_MEASUREMENT_ID=CHANGE_ME

# ── Mux (lecteur vidéo côté frontend) ───────────────────────────────
VITE_MUX_ENV_KEY=CHANGE_ME_MUX_ENV_KEY
